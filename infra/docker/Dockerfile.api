# Limen API — multi-stage uv build (§3.12)
#
# Builds in a tiny image with uv + system deps for GeoPandas/Rasterio,
# then runs from a slim Python base. The runtime image carries the
# resolved virtualenv (no uv at runtime) for a small footprint.

# ---------------------------------------------------------------------------
# Stage 1 — builder
# ---------------------------------------------------------------------------
# Pinned to bookworm: on trixie the runtime lib package names change
# (libgdal32→libgdal36, libgeos-c1v5→libgeos-c1t64), breaking the runtime stage.
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system \
    UV_NO_PROGRESS=1

# System deps required by GeoPandas / Shapely / Rasterio / asyncpg build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libgdal-dev \
        gdal-bin \
        libgeos-dev \
        libproj-dev \
        proj-bin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.7 /uv /usr/local/bin/uv

WORKDIR /app

# Layer split: dependencies first (invalidated only by lockfile changes),
# source afterwards — otherwise every code edit re-downloads the whole
# ml/mcp dependency set (~10 min per build).
COPY pyproject.toml uv.lock README.md ./
# `--group ml` ships lightgbm+mlflow+shap so the shadow challenger can load
# in-container; without it resolve_challenger degrades to None (logged).
# `--group mcp` ships fastmcp so the same image serves `limen mcp-serve`.
# `--group report` ships jinja2+pillow for the static-HTML risk report.
# `--group copernicus` ships cdsapi+netCDF4 for the GloFAS forecast from EWDS.
# `--group storage` ships boto3: the nightly backup goes to an S3-compatible
# bucket off the server (#304).
# `--group agents` ships the anthropic SDK for the evening faithfulness
# reviewer, which sends its sample as a Message Batch. LLM__PROVIDER stays
# pinned in the compose, so the SDK being there does not switch providers.
RUN uv sync --frozen --no-dev --no-editable --no-install-project \
    --group ml --group mcp --group report --group copernicus --group storage --group agents
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable \
    --group ml --group mcp --group report --group copernicus --group storage --group agents

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    API__HOST=0.0.0.0 \
    API__PORT=8080 \
    LOG_JSON=true

# Minimal system libs for the geospatial stack at runtime, plus the
# PostgreSQL 16 client for the nightly backup (#304): pg_dump must match the
# server's major version, and bookworm ships 15, so it comes from PGDG.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libgdal32 \
        libgeos-c1v5 \
        libproj25 \
        libgomp1 \
        postgresql-client-16 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system limen \
    && useradd --system --gid limen --create-home --home-dir /home/limen limen

WORKDIR /app

# Copy the resolved virtualenv and project sources from the builder.
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/pyproject.toml /app/pyproject.toml

USER limen

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
    CMD python -c "import urllib.request, sys; \
                    sys.exit(0 if urllib.request.urlopen('http://localhost:8080/ready', timeout=3).status == 200 else 1)"

CMD ["limen", "serve"]
