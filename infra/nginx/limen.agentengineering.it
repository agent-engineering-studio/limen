# limen.agentengineering.it — reverse proxy di Limen sul suo dominio
#
#   /            -> limen-frontend-static (127.0.0.1:5173)
#   /api/        -> limen-api             (127.0.0.1:8080)  rotte gia' sotto /api
#   /tiles/      -> limen-pg-tileserv     (127.0.0.1:7800)  prefisso rimosso
#
# Le stesse rotte di office-gdc.w3pro.it, senza /inference. Il frontend e'
# costruito con VITE_API_URL=/ e VITE_TILESERV_URL=/tiles: chiama l'API sul
# dominio da cui e' stato aperto, quindi la stessa build serve entrambi.
#
# Attivazione: lo script infra/nginx/attiva-limen-agentengineering.sh, dopo
# il CNAME limen.agentengineering.it -> office-gdc.w3pro.it (IP dinamico). Il file in sites-enabled e' un
# symlink, non una copia, come per office-gdc.
#
# Richiede /etc/nginx/snippets/office-gdc-proxy.conf e la map
# $connection_upgrade in /etc/nginx/conf.d/upgrade.conf.

server {
    listen 80;
    listen [::]:80;
    server_name limen.agentengineering.it;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name limen.agentengineering.it;

    ssl_certificate     /etc/letsencrypt/live/limen.agentengineering.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/limen.agentengineering.it/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/limen.agentengineering.it/chain.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/limen.access.log;
    error_log  /var/log/nginx/limen.error.log;

    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/office-gdc-proxy.conf;
        proxy_buffering off;
        proxy_read_timeout 900s;
    }

    location = /health       { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/office-gdc-proxy.conf; }
    location = /openapi.json { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/office-gdc-proxy.conf; }
    location = /docs         { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/office-gdc-proxy.conf; }
    location = /redoc        { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/office-gdc-proxy.conf; }

    location /tiles/ {
        proxy_pass http://127.0.0.1:7800/;
        include /etc/nginx/snippets/office-gdc-proxy.conf;
        proxy_read_timeout 60s;
        proxy_buffering on;
    }

    location / {
        proxy_pass http://127.0.0.1:5173;
        include /etc/nginx/snippets/office-gdc-proxy.conf;
        proxy_read_timeout 60s;
    }
}
