{
  "mcpServers": {
    "idrogeo": {
      "command": "uvx",
      "args": ["--from", "ispra-idrogeo[mcp]~=0.7", "idrogeo-mcp"]
    },
    "imageserver": {
      "command": "uvx",
      "args": ["--from", "imageserver-export[mcp]~=0.2", "imageserver-mcp"]
    },
    "copernicus-ems": {
      "command": "uvx",
      "args": ["--from", "copernicus-ems[mcp]~=0.6", "copernicus-ems", "mcp"]
    }
  }
}
